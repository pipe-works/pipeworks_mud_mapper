#!/bin/bash
# prepare-commit-msg hook for pipeworks_mud_mapper
#
# Automatically generates commit messages for data-only changes.
# When all staged files are local data artifacts (under data/), this hook
# generates a standardized commit message with [skip ci] to avoid
# triggering CI for non-code changes.
#
# Installation:
#   cp scripts/hooks/prepare-commit-msg .git/hooks/
#   chmod +x .git/hooks/prepare-commit-msg
#
# Or use the install script:
#   ./scripts/install-hooks.sh

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

# Only auto-generate for regular commits (not merges, squashes, etc.)
# COMMIT_SOURCE is empty for regular commits
if [ -n "$COMMIT_SOURCE" ]; then
    exit 0
fi

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only)

# If no staged files, exit
if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# Check if ALL staged files are data artifacts
# grep -v returns non-zero if no lines match (all files are data files)
NON_DATA_FILES=$(echo "$STAGED_FILES" | grep -vE '^data/')

if [ -n "$NON_DATA_FILES" ]; then
    # There are non-data files staged - don't auto-generate message
    exit 0
fi

# All staged files are data files - generate automatic commit message
MSG="chore(data): update local artifacts [skip ci]"

# Write the auto-generated message
echo "$MSG" > "$COMMIT_MSG_FILE"
echo "" >> "$COMMIT_MSG_FILE"
echo "# Auto-generated commit message for data-only changes." >> "$COMMIT_MSG_FILE"
echo "# [skip ci] prevents CI from running on non-code changes." >> "$COMMIT_MSG_FILE"
echo "#" >> "$COMMIT_MSG_FILE"
echo "# Files:" >> "$COMMIT_MSG_FILE"
echo "$STAGED_FILES" | sed 's/^/#   /' >> "$COMMIT_MSG_FILE"
